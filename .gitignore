# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Harness-local instruction overlay (symlink into ~/.claude; machine-specific)
AGENTS.local.md

# macOS and IDE metadata (machine-specific)
.DS_Store
.idea/

# Local data, not versioned
data/

# Round files are transport, not record: the folder's rulebook is versioned, its content is not
docs/reviews/*
!docs/reviews/README.md

# Watcher runtime state: a cache of the registry scan and the chain counter, not record
tools/.watcher-state.json*
tools/.watcher-hops/

# Claude Code machine-local settings (hook config carries absolute store paths)
.claude/settings.local.json
tools/monitor.lock
